# ---------------------------------------------------------------
# Roam configuration. Every variable is optional.
# ---------------------------------------------------------------
PORT=3000

# Assistant name and wake words (browser listens for these). Keep names short and distinct.
ASSISTANT_NAME=roam
WAKE_WORDS=roam,rome,rom

# --- Naturalist LLM: any OpenAI-compatible endpoint serving an open-weight model ---
# FULLY OFFLINE (recommended): local Ollama. Works with no internet.
#   ollama pull gemma2:2b   (fast on a laptop CPU, ~1.6 GB)
#   ollama pull gemma2:9b   (better answers, slower, ~5.4 GB)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma2:2b
# Hosted open-weight alternative (data leaves the device; NOT offline):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=gsk_...

# --- TabPFN ---
# Persistent service (recommended): uvicorn tabpfn_api:app --app-dir services --port 8001
# TABPFN_SERVICE_URL=http://localhost:8001
# Python used by the CLI fallback (defaults to python3 on Linux/macOS, python on Windows)
# PYTHON_BIN=python

# --- Optional services (each has a built-in offline fallback) ---
# Leave these blank for a fully offline setup. Browser speech is used for voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SENTRY_DSN=
SERPAPI_API_KEY=
GROQ_API_KEY=            # only for server-side Whisper transcription (needs internet)

